# Copy this file to docker.env and edit values if needed.

APP_PORT=3002
VLLM_PORT=8000

# Docker image for the OpenAI-compatible vLLM server.
VLLM_IMAGE=vllm/vllm-openai:latest

# Default model for summaries, protocols, and free-form text tasks.
# Qwen3-14B-AWQ is the safe Docker default for 24 GB GPUs.
# Qwen/Qwen3-32B-AWQ can be tried manually, but it may leave no KV-cache on RTX 4090.
VLLM_MODEL_NAME=Qwen/Qwen3-14B-AWQ
VLLM_QUANTIZATION=awq
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_TIMEOUT_SECONDS=600
VLLM_API_KEY=

# Optional Hugging Face token for gated models such as pyannote.
HF_TOKEN=

# Keep Whisper on CPU by default so vLLM can use the GPU memory.
# Change to cuda only if there is enough free VRAM.
WHISPER_MODEL_NAME=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=auto
WHISPER_BATCH_SIZE=8
WHISPER_CPU_THREADS=12
WHISPER_NUM_WORKERS=6

SUMMARY_MAX_CHUNK_SIZE=4096
SUMMARY_MAX_NEW_TOKENS=2500
BROWSER_CAPTURE_SEGMENT_MS=60000
LOG_LEVEL=INFO
